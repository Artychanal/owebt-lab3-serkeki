# Create the bot via @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=replace_with_telegram_token

# Create the key in Google AI Studio.
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated Telegram user IDs allowed to use the bot.
ALLOWED_USER_IDS=your_telegram_user_id

# Use polling locally and webhook on a hosting service.
RUN_MODE=polling
WEBHOOK_BASE_URL=https://your-service.example.com
WEBHOOK_PATH=/telegram/webhook
# Only A-Z, a-z, 0-9, underscore and hyphen are allowed by Telegram.
WEBHOOK_SECRET=replace_with_a_random_secret_2026
PORT=8080
